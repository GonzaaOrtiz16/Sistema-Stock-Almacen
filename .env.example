# Obtener en: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Usado en el renderer (expuesto a Vite)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Usado en el proceso principal de Electron (NO expuesto al browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

NODE_ENV=development

# Solo necesario para publicar releases (npm run release)
# Generar en: https://github.com/settings/tokens → Classic → scope: repo
GH_TOKEN=ghp_...
